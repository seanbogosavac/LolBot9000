DISCORD_TOKEN=
DISCORD_CHANNEL=
RIOT_API_KEY=
LOG_LEVEL=INFO
# LOG_FILE=

# Optional: where the SQLite player database lives (default: <project>/data/players.db,
# mounted as the "players-db" volume at /app/data in docker-compose).
# PLAYERS_DB=/app/data/players.db

# Players are no longer configured here: register them in Discord with
#   !addplayer Pseudo <@discord> RiotPseudo#TAG
# The old DISCORD_ID_* / RIOT_ID_* variables are not read any more; the SQLite database is
# the only source of the roster.
